{
  "name": "public",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:cov": "ng test --code-coverage",
    "test:headless": "ng test --watch=false",
    "contract:generate": "openapi-typescript ../../api/openapi/openapi.json -o src/app/core/api/generated/api.types.ts",
    "contract:check": "openapi-typescript ../../api/openapi/openapi.json -o src/app/core/api/generated/api.types.ts --check",
    "test:contract": "npm run contract:check && ng test --watch=false --include=src/app/core/api/public-contract.fixture.spec.ts",
    "lint": "ng lint --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"src/**/*.html\" eslint.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.19",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "bpmn-js": "^18.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^20.0.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
