{
  "name": "process-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:all": "npm install && npm install --prefix api && npm install --prefix web/backoffice && npm install --prefix web/public && concurrently --kill-others-on-fail \"npm run start:dev --prefix api\" \"npm run start --prefix web/backoffice\" \"npm run start --prefix web/public\" \"wait-on http://localhost:3000/health && npm run swagger --prefix api\"",
    "test": "npm run test:unit",
    "test:unit": "concurrently --kill-others-on-fail --names api,backoffice,public,scripts \"npm test --prefix api\" \"npm run test:headless --prefix web/backoffice\" \"npm run test:headless --prefix web/public\" \"npm run test:scripts\"",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.ts",
    "test:naming": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-test-conventions.ts",
    "test:naming:fix": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-test-conventions.ts --fix",
    "test:integration": "npm run test:integration --prefix api",
    "test:contract": "npm run test:contract --prefix api && npm run test:contract --prefix web/backoffice && npm run test:contract --prefix web/public",
    "test:e2e": "npm run test:e2e --prefix api",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:coverage": "npm run test:cov --prefix api && npm run test:cov --prefix web/backoffice && npm run test:cov --prefix web/public && npm run test:cov:scripts && npm run coverage:normalize",
    "test:cov:scripts": "node -e \"require('node:fs').mkdirSync('scripts/coverage',{recursive:true})\" && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=scripts/coverage/lcov.info scripts/*.test.ts",
    "coverage:normalize": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/normalize-lcov.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e",
    "diagnostics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics.ts all",
    "diagnostics:fast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics.ts fast",
    "diagnostics:local": "npm run diagnostics:fast",
    "diagnostics:sonar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics.ts sonar",
    "sonar:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sonar-check.ts",
    "sonar:start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sonar-local.ts start",
    "sonar:stop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sonar-local.ts stop",
    "sonar:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sonar-local.ts status",
    "sonar:token": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sonar-local.ts token",
    "test:diagnostics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics-regression.ts all",
    "test:diagnostics:fast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics-regression.ts fast",
    "test:diagnostics:sonar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/diagnostics-regression.ts sonar",
    "test:diagnostics:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test ./scripts/sonar-api.test.ts ./scripts/normalize-lcov.test.ts ./scripts/diagnostics.test.ts ./scripts/sonar-local.test.ts",
    "test:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test ./scripts/check-links.test.ts",
    "links:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-links.ts --external",
    "links:check:internal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-links.ts",
    "quality:check": "npm run diagnostics",
    "lint": "npm run lint:root && npm run lint:check --prefix api && npm run lint:check --prefix web/public && npm run lint:check --prefix web/backoffice && npm run check:component-modules --prefix web/backoffice && npm run test:naming",
    "lint:root": "eslint \"scripts/**/*.ts\" \"verification/scripts/**/*.ts\" \"playwright.config.ts\" \"e2e/**/*.ts\" eslint.config.js --max-warnings=0",
    "typecheck": "npm run typecheck:root && npm run typecheck --prefix api && npm run typecheck --prefix web/public && npm run typecheck --prefix web/backoffice",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build --prefix api && npm run build --prefix web/public && npm run build --prefix web/backoffice",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./verification/scripts/verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sonar/scan": "^4.3.5",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^9.0.5"
  }
}
